FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        curl \
        dbus-x11 \
        gnome-keyring \
        fonts-cantarell \
        fonts-dejavu-core \
        git \
        imagemagick \
        libcmark-gfm-dev \
        libsecret-tools \
        libgtk-4-dev \
        libgtksourceview-5-dev \
        libvte-2.91-gtk4-dev \
        libwebkitgtk-6.0-dev \
        xauth \
        xdotool \
        unzip \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
        https://download.swift.org/swift-6.1-release/ubuntu2404/swift-6.1-RELEASE/swift-6.1-RELEASE-ubuntu24.04.tar.gz \
        -o /tmp/swift.tar.gz \
    && tar -xzf /tmp/swift.tar.gz -C /opt \
    && rm /tmp/swift.tar.gz

ARG BUN_VERSION=1.3.14
RUN curl -fsSL \
        "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" \
        -o /tmp/bun.zip \
    && unzip -q /tmp/bun.zip -d /tmp \
    && install -m 0755 /tmp/bun-linux-x64/bun /usr/local/bin/bun \
    && rm -rf /tmp/bun.zip /tmp/bun-linux-x64

ENV PATH="/opt/swift-6.1-RELEASE-ubuntu24.04/usr/bin:${PATH}"
