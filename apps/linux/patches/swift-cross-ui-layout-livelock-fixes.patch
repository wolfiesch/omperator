+        let text: String
+        let proposedWidth: Int?
+        let proposedHeight: Int?
+        let ellipsizing: Bool
+        let font: Font
+        let lineLimit: LineLimit?
+    }
+
+    private var textSizeCache: [TextSizeCacheKey: SIMD2<Int>] = [:]
