{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "enabled",
    "clusterHost",
    "kubernetes",
    "images",
    "controller",
    "server",
    "sshGateway",
    "session",
    "modelGateway",
    "imagePrePull",
    "storage",
    "woodpecker",
    "ingress",
    "networkPolicy",
    "observability"
  ],
  "properties": {
    "enabled": { "type": "boolean", "default": false },
    "clusterHost": {
      "type": "object",
      "required": ["name", "runtimeProfiles", "allowedOrigins"],
      "properties": {
        "name": { "$ref": "#/definitions/dnsSubdomain" },
        "runtimeProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/runtimeProfile" }
        },
        "allowedOrigins": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https://[^/?#]+$", "maxLength": 256 }
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "required": ["apiAudience"],
      "properties": {
        "apiAudience": { "$ref": "#/definitions/audience" }
      }
    },
    "images": {
      "type": "object",
      "required": ["controller", "server", "sshGateway", "sessionRuntime", "modelGateway"],
      "properties": {
        "controller": { "$ref": "#/definitions/image" },
        "server": { "$ref": "#/definitions/image" },
        "sshGateway": { "$ref": "#/definitions/image" },
        "sessionRuntime": { "$ref": "#/definitions/image" },
        "modelGateway": { "$ref": "#/definitions/image" }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "$ref": "#/definitions/dnsSubdomain" } }
      }
    },
    "controller": {
      "type": "object",
      "required": ["replicas", "runtimeActivityPollSeconds", "resources"],
      "properties": {
        "replicas": { "type": "integer", "const": 2 },
        "runtimeActivityPollSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "resources": { "type": "object" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "terminationGracePeriodSeconds", "autoscaling", "identity", "trustedProxyAddresses", "trustedProxyCIDRs", "publicApi", "admission", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 2, "maximum": 9 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30, "maximum": 300 },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapters", "configMapRef", "secretRef"],
          "properties": {
            "adapters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["tailscale", "oidc", "mtls"] }
            },
            "configMapRef": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": { "type": "string", "pattern": "^$|^[a-z0-9](?:[-a-z0-9]{0,251}[a-z0-9])?$" },
                "key": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
              }
            },
            "secretRef": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": { "type": "string", "pattern": "^$|^[a-z0-9](?:[-a-z0-9]{0,251}[a-z0-9])?$" },
                "key": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
              }
            }
          },
          "allOf": [
            {
              "not": {
                "properties": {
                  "configMapRef": { "properties": { "name": { "minLength": 1 } } },
                  "secretRef": { "properties": { "name": { "minLength": 1 } } }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "configMapRef": { "properties": { "name": { "const": "" } } },
                  "secretRef": { "properties": { "name": { "const": "" } } }
                }
              },
              "then": {
                "properties": {
                  "adapters": { "maxItems": 1, "items": { "const": "tailscale" } }
                }
              }
            }
          ]
        },
        "trustedProxyAddresses": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "anyOf": [{ "format": "ipv4" }, { "format": "ipv6" }] }
        },
        "trustedProxyCIDRs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonDefaultRouteCIDR" }
        },
        "publicApi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["restBaseURL", "ompAppWebSocketURL", "build"],
          "properties": {
            "restBaseURL": { "type": "string", "maxLength": 2048, "pattern": "^$|^https://[^/@\\s?#]+/v1$" },
            "ompAppWebSocketURL": { "type": "string", "maxLength": 2048, "pattern": "^$|^wss://[^/@\\s?#]+/v1/ws$" },
            "build": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "revision", "builtAt"],
              "properties": {
                "version": { "type": "string", "maxLength": 64, "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._+:/~-]*$" },
                "revision": { "type": "string", "maxLength": 128, "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._+:/~-]*$" },
                "builtAt": { "type": "string", "maxLength": 64 }
              }
            }
          }
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxActiveRuntimes", "maxRetainedRuntimes", "maxWorkspaceCapacityBytes", "maxCpuMillis", "maxMemoryBytes", "maxGpuUnits", "browserEnabled", "runtimeResources", "creationRate"],
          "properties": {
            "maxActiveRuntimes": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "maxRetainedRuntimes": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "maxWorkspaceCapacityBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "maxCpuMillis": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
            "maxMemoryBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "maxGpuUnits": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "browserEnabled": { "type": "boolean" },
            "runtimeResources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpuMillis", "memoryBytes", "gpuUnits"],
              "properties": {
                "cpuMillis": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
                "memoryBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "gpuUnits": { "type": "integer", "minimum": 0, "maximum": 1000000 }
              }
            },
            "creationRate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["windowSeconds", "burst", "maximumRetryAfterSeconds"],
              "properties": {
                "windowSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
                "burst": { "type": "integer", "minimum": 1, "maximum": 100000 },
                "maximumRetryAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
              }
            }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "sshGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "terminationGracePeriodSeconds", "autoscaling", "handlerModule", "commands", "existingHostKeySecret", "hostKeyKey", "existingAuthorizedKeysSecret", "authorizedKeysKey", "existingProviderAssertionSecret", "providerAssertionKeyringKey", "providerInternalWebSocketURL", "existingTrustedCASecret", "trustedCAKey", "existingPrincipalsSecret", "principalsKey", "service", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "handlerModule": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^$|^(?:file:///|/|@?[A-Za-z0-9])[A-Za-z0-9@._/+:-]*$",
          "not": { "pattern": "(^|/)\\.\\.(/|$)" }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "relay", "attach", "version"],
          "properties": {
            "provider": { "type": "boolean" },
            "relay": { "type": "boolean" },
            "attach": { "type": "boolean" },
            "version": { "type": "boolean" }
          }
        },
        "replicas": { "type": "integer", "minimum": 2, "maximum": 9 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 15, "maximum": 300 },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "existingHostKeySecret": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "hostKeyKey": { "$ref": "#/definitions/configKey" },
        "existingAuthorizedKeysSecret": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "authorizedKeysKey": { "$ref": "#/definitions/configKey" },
        "existingProviderAssertionSecret": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "providerAssertionKeyringKey": { "$ref": "#/definitions/configKey" },
        "providerInternalWebSocketURL": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^$|^wss?://[a-z0-9.-]+(?::[0-9]{1,5})?/internal/provider$",
          "not": { "pattern": "^(?:ws://[^/]+:80|wss://[^/]+:443)/internal/provider$" }
        },
        "existingTrustedCASecret": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "trustedCAKey": { "$ref": "#/definitions/configKey" },
        "existingPrincipalsSecret": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "principalsKey": { "$ref": "#/definitions/configKey" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port", "annotations", "loadBalancerSourceRanges"],
          "properties": {
            "type": { "type": "string", "enum": ["LoadBalancer", "ClusterIP", "NodePort"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
            "loadBalancerSourceRanges": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/nonDefaultRouteCIDR" }
            }
          }
        },
        "resources": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "properties": {
              "existingHostKeySecret": { "minLength": 1 },
              "existingAuthorizedKeysSecret": { "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "commands": {
                "anyOf": [
                  { "properties": { "provider": { "const": true } } },
                  { "properties": { "relay": { "const": true } } },
                  { "properties": { "attach": { "const": true } } }
                ]
              }
            }
          },
          "then": { "properties": { "handlerModule": { "minLength": 1 } } }
        },
        {
          "if": { "properties": { "commands": { "properties": { "provider": { "const": true } } } } },
          "then": { "properties": { "existingProviderAssertionSecret": { "minLength": 1 } } }
        },
        {
          "if": { "properties": { "existingTrustedCASecret": { "minLength": 1 } } },
          "then": { "properties": { "existingPrincipalsSecret": { "minLength": 1 } } }
        },
        {
          "if": { "properties": { "existingPrincipalsSecret": { "minLength": 1 } } },
          "then": { "properties": { "existingTrustedCASecret": { "minLength": 1 } } }
        }
      ]
    },
    "session": {
      "type": "object",
      "required": ["nodeExclude", "resources", "sharedMemorySize", "temporarySize", "omp"],
      "properties": {
        "nodeExclude": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "contains": { "const": "k3s-worker-02" },
          "items": { "$ref": "#/definitions/dnsLabel" }
        },
        "resources": { "type": "object" },
        "sharedMemorySize": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" },
        "temporarySize": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$" },
        "omp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configMap", "modelsKey", "settingsKey"],
          "properties": {
            "configMap": { "$ref": "#/definitions/optionalDNSSubdomain" },
            "modelsKey": { "$ref": "#/definitions/optionalConfigKey" },
            "settingsKey": { "$ref": "#/definitions/optionalConfigKey" }
          }
        }
      }
    },
    "modelGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "upstreamOrigin", "allowedPaths", "existingSecret", "credentialKey", "credentialHeader", "timeoutMs", "maxRequestBodyBytes", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 2, "maximum": 9 },
        "upstreamOrigin": { "type": "string", "maxLength": 256, "pattern": "^$|^https://[A-Za-z0-9](?:[-.A-Za-z0-9]*[A-Za-z0-9])?(?::[1-9][0-9]{0,4})?$" },
        "allowedPaths": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@/-]+$" },
              { "not": { "pattern": "^//" } }
            ]
          }
        },
        "existingSecret": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "credentialKey": { "$ref": "#/definitions/configKey" },
        "credentialHeader": { "type": "string", "enum": ["authorization", "x-api-key", "api-key"] },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 900000 },
        "maxRequestBodyBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 },
        "resources": { "type": "object" }
      }
    },
    "imagePrePull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "resources": { "type": "object" }
      }
    },
    "storage": {
      "type": "object",
      "required": ["adminRWXStorageClass", "runtimeStateStorageClass", "runtimeStateSize", "runtimeStateAccessMode", "volumeSnapshotClass"],
      "properties": {
        "adminRWXStorageClass": {
          "allOf": [{ "$ref": "#/definitions/optionalDNSSubdomain" }]
        },
        "runtimeStateStorageClass": {
          "allOf": [{ "$ref": "#/definitions/optionalDNSSubdomain" }]
        },
        "runtimeStateSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)$"
        },
        "runtimeStateAccessMode": {
          "type": "string",
          "enum": ["ReadWriteOncePod", "ReadWriteOnce"]
        },
        "volumeSnapshotClass": {
          "allOf": [{ "$ref": "#/definitions/optionalDNSSubdomain" }]
        }
      },
      "additionalProperties": false
    },
    "woodpecker": {
      "type": "object",
      "required": ["existingSecret", "tokenKey", "configMap", "baseURLKey", "webBaseURLKey", "repositoriesKey", "serviceAccountAudience", "tokenExpirationSeconds"],
      "properties": {
        "existingSecret": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "tokenKey": { "$ref": "#/definitions/configKey" },
        "configMap": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "baseURLKey": { "$ref": "#/definitions/configKey" },
        "repositoriesKey": { "$ref": "#/definitions/configKey" },
        "webBaseURLKey": { "$ref": "#/definitions/configKey" },
        "serviceAccountAudience": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "tokenExpirationSeconds": { "type": "integer", "minimum": 600, "maximum": 3600 }
      },
      "oneOf": [
        { "properties": { "existingSecret": { "maxLength": 0 }, "configMap": { "maxLength": 0 }, "serviceAccountAudience": { "maxLength": 0 } } },
        { "properties": { "existingSecret": { "minLength": 1 }, "configMap": { "minLength": 1 }, "serviceAccountAudience": { "maxLength": 0 } } },
        { "properties": { "existingSecret": { "maxLength": 0 }, "configMap": { "minLength": 1 }, "serviceAccountAudience": { "minLength": 1 } } }
      ]
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "host", "annotations", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "$ref": "#/definitions/optionalDNSLabel" },
        "host": { "$ref": "#/definitions/optionalDNSSubdomain" },
        "annotations": { "type": "object" },
        "tls": {
          "type": "object",
          "required": ["enabled", "secretName"],
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "$ref": "#/definitions/optionalDNSSubdomain" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "kubernetesApiCIDRs", "identityProviderCIDRs", "sshIngressCIDRs", "sshBackendCIDRs", "sshBackendPorts", "sshBackend", "modelRouteCIDRs", "modelRoutePorts", "modelRoute", "modelGatewayUpstreamCIDRs", "modelGatewayUpstreamPorts", "ciProviderCIDRs", "ciProviderPorts", "ciProvider", "dns", "gatewayIngress", "observability"],
      "properties": {
        "enabled": { "type": "boolean" },
        "kubernetesApiCIDRs": { "$ref": "#/definitions/cidrList" },
        "identityProviderCIDRs": { "$ref": "#/definitions/cidrList" },
        "sshIngressCIDRs": { "$ref": "#/definitions/cidrList" },
        "sshBackendCIDRs": { "$ref": "#/definitions/cidrList" },
        "sshBackendPorts": { "$ref": "#/definitions/tcpPortList" },
        "sshBackend": { "$ref": "#/definitions/pairedSelectors" },
        "modelRouteCIDRs": { "$ref": "#/definitions/cidrList" },
        "modelRoutePorts": { "$ref": "#/definitions/tcpPortList" },
        "modelRoute": { "$ref": "#/definitions/pairedSelectors" },
        "modelGatewayUpstreamCIDRs": { "$ref": "#/definitions/cidrList" },
        "modelGatewayUpstreamPorts": { "$ref": "#/definitions/tcpPortList" },
        "ciProviderCIDRs": { "$ref": "#/definitions/cidrList" },
        "ciProviderPorts": { "$ref": "#/definitions/tcpPortList" },
        "ciProvider": { "$ref": "#/definitions/pairedSelectors" },
        "dns": {
          "type": "object",
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": { "allOf": [{ "$ref": "#/definitions/labelSelector" }], "minProperties": 1 },
            "podSelector": { "allOf": [{ "$ref": "#/definitions/labelSelector" }], "minProperties": 1 }
          }
        },
        "gatewayIngress": { "$ref": "#/definitions/pairedSelectors" },
        "observability": { "$ref": "#/definitions/pairedSelectors" }
      }
    },
    "observability": {
      "type": "object",
      "required": ["serviceMonitor", "prometheusRule"],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "required": ["enabled", "interval", "labels"],
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
            "labels": { "type": "object" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "required": ["enabled", "labels"],
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object" }
          }
        }
      }
    }
  },
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "optionalDNSLabel": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "optionalDNSSubdomain": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "runtimeProfile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]([-._a-z0-9]{0,62}[a-z0-9])?$"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "configKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[-._A-Za-z0-9]+$"
    },
    "optionalConfigKey": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[-._A-Za-z0-9]+$"
    },
    "nonDefaultRouteCIDR": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9A-Fa-f:.]+/([1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
    },
    "cidrList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/nonDefaultRouteCIDR" }
    },
    "tcpPortList": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "labelSelector": {
      "type": "object",
      "maxProperties": 2,
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": { "type": "string", "maxLength": 63 }
        },
        "matchExpressions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 253 },
              "operator": { "type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 63 } }
            }
          }
        }
      }
    },
    "pairedSelectors": {
      "type": "object",
      "required": ["namespaceSelector", "podSelector"],
      "properties": {
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "podSelector": { "$ref": "#/definitions/labelSelector" }
      },
      "oneOf": [
        {
          "properties": {
            "namespaceSelector": { "maxProperties": 0 },
            "podSelector": { "maxProperties": 0 }
          }
        },
        {
          "properties": {
            "namespaceSelector": { "minProperties": 1 },
            "podSelector": { "minProperties": 1 }
          }
        }
      ]
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage", "targetMemoryUtilizationPercentage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 2, "maximum": 9 },
        "maxReplicas": { "type": "integer", "minimum": 2, "maximum": 32 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 10, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": "integer", "minimum": 10, "maximum": 100 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 256 },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "server": {
            "anyOf": [
              { "properties": { "trustedProxyAddresses": { "minItems": 1 } } },
              { "properties": { "trustedProxyCIDRs": { "minItems": 1 } } }
            ],
            "properties": {
              "publicApi": {
                "properties": {
                  "restBaseURL": { "minLength": 12 },
                  "ompAppWebSocketURL": { "minLength": 12 },
                  "build": {
                    "properties": {
                      "version": { "minLength": 1 },
                      "revision": { "minLength": 1 },
                      "builtAt": { "minLength": 1, "format": "date-time" }
                    }
                  }
                }
              }
            }
          },
          "storage": {
            "properties": {
              "adminRWXStorageClass": { "minLength": 1 },
              "runtimeStateStorageClass": { "minLength": 1 },
              "volumeSnapshotClass": { "minLength": 1 }
            }
          },
          "session": {
            "properties": {
              "omp": {
                "properties": {
                  "configMap": { "minLength": 1 },
                  "modelsKey": { "minLength": 1 },
                  "settingsKey": { "minLength": 1 }
                }
              }
            }
          },
          "images": {
            "properties": {
              "controller": { "properties": { "digest": { "pattern": "^sha256:[0-9a-f]{64}$" } } },
              "server": { "properties": { "digest": { "pattern": "^sha256:[0-9a-f]{64}$" } } },
              "sessionRuntime": { "properties": { "digest": { "pattern": "^sha256:[0-9a-f]{64}$" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "modelGateway": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "enabled": { "const": true },
          "modelGateway": {
            "properties": {
              "upstreamOrigin": { "minLength": 1 },
              "allowedPaths": { "minItems": 1 },
              "existingSecret": { "minLength": 1 }
            }
          },
          "images": {
            "properties": {
              "modelGateway": { "properties": { "digest": { "pattern": "^sha256:[0-9a-f]{64}$" } } }
            }
          },
          "networkPolicy": {
            "properties": {
              "enabled": { "const": true },
              "modelRouteCIDRs": { "maxItems": 0 },
              "modelRoutePorts": { "maxItems": 0 },
              "modelRoute": {
                "properties": {
                  "namespaceSelector": { "maxProperties": 0 },
                  "podSelector": { "maxProperties": 0 }
                }
              },
              "modelGatewayUpstreamCIDRs": { "minItems": 1 },
              "modelGatewayUpstreamPorts": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "ingress": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "className": { "const": "tailscale" },
              "host": { "minLength": 1 },
              "tls": {
                "properties": {
                  "enabled": { "const": true },
                  "secretName": { "maxLength": 0 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "server": {
            "properties": {
              "identity": {
                "properties": {
                  "adapters": { "contains": { "const": "oidc" } }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "networkPolicy": {
            "properties": {
              "enabled": { "const": true },
              "identityProviderCIDRs": { "minItems": 1 }
            }
          }
        }
      }
    }
  ]
}
