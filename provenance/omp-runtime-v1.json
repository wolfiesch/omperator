      "project.rootForProject",
      "project.rootForSession",
      "lock.check",
      "lock.status",
      "operation.filesRead",
      "operation.filesList",
      "operation.filesDiff",
      "operation.filesWrite",
      "operation.filesPatch",
      "operation.reviewRead",
      "operation.reviewApply",
      "operation.bashRun",
      "operation.termOpen",
      "operation.catalogGet",
      "operation.settingsRead",
      "operation.brokerStatus",
      "operation.settingsWrite",
      "operation.configWrite",
      "terminal.input",
      "terminal.resize",
      "terminal.close",
      "usage.read"
    ],
    "evidence": {
      "sourceTests": [
        "packages/coding-agent/test/appserver-bridge.test.ts",
        "packages/coding-agent/test/appserver-bridge-smoke.test.ts"
      ],
      "hostGate": "pnpm verify:current-omp-bridge"
