{
  "openapi": "3.1.0",
  "info": {
    "title": "Omperator Portable Agent Platform API",
    "version": "1.0.0",
    "description": "Portable lifecycle and discovery API for durable workspaces and runtimes."
  },
  "servers": [{ "url": "https://api.example.invalid" }],
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/.well-known/omperator": {
      "get": {
        "operationId": "getDiscovery",
        "security": [],
        "responses": {
          "200": { "$ref": "#/components/responses/DiscoveryResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "200": { "$ref": "#/components/responses/VersionResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": { "$ref": "#/components/responses/CapabilitiesResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/scopes": {
      "get": {
        "operationId": "listScopes",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ScopePageResponse" },
          "400": { "$ref": "#/components/responses/ProblemResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/ScopeFilter" },
          { "$ref": "#/components/parameters/PhaseFilter" },
          { "$ref": "#/components/parameters/UpdatedSinceFilter" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/WorkspacePageResponse" },
          "400": { "$ref": "#/components/responses/ProblemResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/workspaces/{workspaceId}": {
      "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/ScopeFilter" }],
      "put": {
        "operationId": "putWorkspace",
        "parameters": [{ "$ref": "#/components/parameters/IfNoneMatch" }],
        "requestBody": { "$ref": "#/components/requestBodies/WorkspaceCreate" },
        "responses": {
          "200": { "$ref": "#/components/responses/WorkspaceResponse" },
          "201": { "$ref": "#/components/responses/WorkspaceCreatedResponse" },
          "202": { "$ref": "#/components/responses/WorkspaceAcceptedResponse" },
          "400": { "$ref": "#/components/responses/ProblemResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "403": { "$ref": "#/components/responses/ProblemResponse" },
          "409": { "$ref": "#/components/responses/ProblemResponse" },
          "412": { "$ref": "#/components/responses/ProblemResponse" },
          "422": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      },
      "get": {
        "operationId": "getWorkspace",
        "responses": {
          "200": { "$ref": "#/components/responses/WorkspaceResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "404": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      },
      "patch": {
        "operationId": "patchWorkspace",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "$ref": "#/components/requestBodies/WorkspacePatch" },
        "responses": {
          "200": { "$ref": "#/components/responses/WorkspaceResponse" },
          "202": { "$ref": "#/components/responses/WorkspaceAcceptedResponse" },
          "400": { "$ref": "#/components/responses/ProblemResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "403": { "$ref": "#/components/responses/ProblemResponse" },
          "404": { "$ref": "#/components/responses/ProblemResponse" },
          "409": { "$ref": "#/components/responses/ProblemResponse" },
          "412": { "$ref": "#/components/responses/ProblemResponse" },
          "422": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      },
      "delete": {
        "operationId": "deleteWorkspace",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "responses": {
          "202": { "$ref": "#/components/responses/WorkspaceAcceptedResponse" },
          "204": { "$ref": "#/components/responses/DeletedResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "403": { "$ref": "#/components/responses/ProblemResponse" },
          "404": { "$ref": "#/components/responses/ProblemResponse" },
          "409": { "$ref": "#/components/responses/ProblemResponse" },
          "412": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/runtimes": {
      "get": {
        "operationId": "listRuntimes",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/ScopeFilter" },
          { "$ref": "#/components/parameters/DesiredStateFilter" },
          { "$ref": "#/components/parameters/PhaseFilter" },
          { "$ref": "#/components/parameters/WorkspaceFilter" },
          { "$ref": "#/components/parameters/UpdatedSinceFilter" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/RuntimePageResponse" },
          "400": { "$ref": "#/components/responses/ProblemResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/runtimes/{runtimeId}": {
      "parameters": [{ "$ref": "#/components/parameters/RuntimeId" }, { "$ref": "#/components/parameters/ScopeFilter" }],
      "put": {
        "operationId": "putRuntime",
        "parameters": [{ "$ref": "#/components/parameters/IfNoneMatch" }],
        "requestBody": { "$ref": "#/components/requestBodies/RuntimeCreate" },
        "responses": {
          "200": { "$ref": "#/components/responses/RuntimeResponse" },
          "201": { "$ref": "#/components/responses/RuntimeCreatedResponse" },
          "202": { "$ref": "#/components/responses/RuntimeAcceptedResponse" },
          "400": { "$ref": "#/components/responses/ProblemResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "403": { "$ref": "#/components/responses/ProblemResponse" },
          "409": { "$ref": "#/components/responses/ProblemResponse" },
          "412": { "$ref": "#/components/responses/ProblemResponse" },
          "422": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      },
      "get": {
        "operationId": "getRuntime",
        "responses": {
          "200": { "$ref": "#/components/responses/RuntimeResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "404": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      },
      "patch": {
        "operationId": "patchRuntime",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "requestBody": { "$ref": "#/components/requestBodies/RuntimePatch" },
        "responses": {
          "200": { "$ref": "#/components/responses/RuntimeResponse" },
          "202": { "$ref": "#/components/responses/RuntimeAcceptedResponse" },
          "400": { "$ref": "#/components/responses/ProblemResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "403": { "$ref": "#/components/responses/ProblemResponse" },
          "404": { "$ref": "#/components/responses/ProblemResponse" },
          "409": { "$ref": "#/components/responses/ProblemResponse" },
          "412": { "$ref": "#/components/responses/ProblemResponse" },
          "422": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      },
      "delete": {
        "operationId": "deleteRuntime",
        "parameters": [{ "$ref": "#/components/parameters/IfMatch" }],
        "responses": {
          "202": { "$ref": "#/components/responses/RuntimeAcceptedResponse" },
          "204": { "$ref": "#/components/responses/DeletedResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "403": { "$ref": "#/components/responses/ProblemResponse" },
          "404": { "$ref": "#/components/responses/ProblemResponse" },
          "409": { "$ref": "#/components/responses/ProblemResponse" },
          "412": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/runtimes/{runtimeId}:wake": {
      "parameters": [{ "$ref": "#/components/parameters/RuntimeId" }, { "$ref": "#/components/parameters/ScopeFilter" }],
      "post": {
        "operationId": "wakeRuntime",
        "parameters": [
          { "$ref": "#/components/parameters/IfMatch" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/RuntimeResponse" },
          "202": { "$ref": "#/components/responses/RuntimeAcceptedResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "403": { "$ref": "#/components/responses/ProblemResponse" },
          "404": { "$ref": "#/components/responses/ProblemResponse" },
          "409": { "$ref": "#/components/responses/ProblemResponse" },
          "412": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/runtimes/{runtimeId}:sleep": {
      "parameters": [{ "$ref": "#/components/parameters/RuntimeId" }, { "$ref": "#/components/parameters/ScopeFilter" }],
      "post": {
        "operationId": "sleepRuntime",
        "parameters": [
          { "$ref": "#/components/parameters/IfMatch" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/RuntimeResponse" },
          "202": { "$ref": "#/components/responses/RuntimeAcceptedResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "403": { "$ref": "#/components/responses/ProblemResponse" },
          "404": { "$ref": "#/components/responses/ProblemResponse" },
          "409": { "$ref": "#/components/responses/ProblemResponse" },
          "412": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/runtimes/{runtimeId}/connections": {
      "parameters": [{ "$ref": "#/components/parameters/RuntimeId" }, { "$ref": "#/components/parameters/ScopeFilter" }],
      "get": {
        "operationId": "getRuntimeConnections",
        "responses": {
          "200": { "$ref": "#/components/responses/ConnectionDescriptorResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "403": { "$ref": "#/components/responses/ProblemResponse" },
          "404": { "$ref": "#/components/responses/ProblemResponse" },
          "409": { "$ref": "#/components/responses/ProblemResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "getEvents",
        "parameters": [
          { "$ref": "#/components/parameters/LastEventId" },
          { "$ref": "#/components/parameters/ScopeFilter" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/EventStreamResponse" },
          "400": { "$ref": "#/components/responses/ProblemResponse" },
          "401": { "$ref": "#/components/responses/UnauthorizedResponse" },
          "503": { "$ref": "#/components/responses/ProblemResponse" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque" }
    },
    "parameters": {
      "WorkspaceId": { "name": "workspaceId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "RuntimeId": { "name": "runtimeId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RuntimeId" } },
      "Limit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
      "Cursor": { "name": "cursor", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/Cursor" } },
      "ScopeFilter": { "name": "scopeId", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/ScopeId" } },
      "DesiredStateFilter": { "name": "desiredState", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/DesiredState" } },
      "PhaseFilter": { "name": "phase", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/Phase" } },
      "WorkspaceFilter": { "name": "workspaceId", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "UpdatedSinceFilter": { "name": "updatedSince", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/Timestamp" } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": true, "schema": { "type": "string", "const": "*" } },
      "IfMatch": { "name": "If-Match", "in": "header", "required": true, "schema": { "$ref": "#/components/schemas/EntityTag" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{15,127}$" } },
      "LastEventId": { "name": "Last-Event-ID", "in": "header", "required": false, "schema": { "$ref": "#/components/schemas/EventId" } }
    },
    "headers": {
      "ETag": { "required": true, "schema": { "$ref": "#/components/schemas/EntityTag" } },
      "Location": { "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/v1/(workspaces|runtimes)/[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" } },
      "RetryAfter": { "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 3600 } },
      "WWWAuthenticate": { "required": true, "schema": { "type": "string", "const": "Bearer" } },
      "CacheControl": { "required": true, "schema": { "type": "string", "const": "no-store" } }
    },
    "requestBodies": {
      "WorkspaceCreate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceCreate" }, "example": { "scopeId": "scope_personal", "displayName": "api-refactor", "capacityBytes": 10737418240, "retention": "Retain" } } } },
      "WorkspacePatch": { "required": true, "content": { "application/merge-patch+json": { "schema": { "$ref": "#/components/schemas/WorkspacePatch" }, "example": { "displayName": "api-refactor-main", "retention": "Retain" } } } },
      "RuntimeCreate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuntimeCreate" }, "example": { "scopeId": "scope_personal", "displayName": "api-refactor", "workspaceId": "ws_01JZ8R4M6K", "hostProfileId": "default", "desiredState": "Running", "browserPolicy": "Allowed" } } } },
      "RuntimePatch": { "required": true, "content": { "application/merge-patch+json": { "schema": { "$ref": "#/components/schemas/RuntimePatch" }, "example": { "desiredState": "Sleeping" } } } }
    },
    "responses": {
      "DiscoveryResponse": { "description": "Service discovery", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Discovery" } } } },
      "VersionResponse": { "description": "Version metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Version" } } } },
      "CapabilitiesResponse": { "description": "Supported operations and limits", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Capabilities" } } } },
      "ScopePageResponse": { "description": "Scope page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScopePage" } } } },
      "WorkspacePageResponse": { "description": "Workspace page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspacePage" } } } },
      "RuntimePageResponse": { "description": "Runtime page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuntimePage" } } } },
      "WorkspaceResponse": { "description": "Workspace", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } },
      "WorkspaceCreatedResponse": { "description": "Workspace created and ready", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Location": { "$ref": "#/components/headers/Location" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } },
      "WorkspaceAcceptedResponse": { "description": "Workspace change accepted", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Location": { "$ref": "#/components/headers/Location" }, "Retry-After": { "$ref": "#/components/headers/RetryAfter" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } },
      "RuntimeResponse": { "description": "Runtime", "headers": { "ETag": { "$ref": "#/components/headers/ETag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Runtime" } } } },
      "RuntimeCreatedResponse": { "description": "Runtime created and ready", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Location": { "$ref": "#/components/headers/Location" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Runtime" } } } },
      "RuntimeAcceptedResponse": { "description": "Runtime change accepted", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Location": { "$ref": "#/components/headers/Location" }, "Retry-After": { "$ref": "#/components/headers/RetryAfter" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Runtime" } } } },
      "ConnectionDescriptorResponse": { "description": "Authorized current routes", "headers": { "ETag": { "$ref": "#/components/headers/ETag" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConnectionDescriptor" } } } },
      "EventStreamResponse": { "description": "Lifecycle invalidations", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" } }, "content": { "text/event-stream": { "schema": { "type": "string", "x-omperator-sse-events": { "invalidation": "#/components/schemas/InvalidationEvent", "reset": "#/components/schemas/ResetEvent" } } } } },
      "DeletedResponse": { "description": "Deletion completed" },
      "ProblemResponse": { "description": "Problem details", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "UnauthorizedResponse": { "description": "Authentication required", "headers": { "WWW-Authenticate": { "$ref": "#/components/headers/WWWAuthenticate" } }, "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "OpaqueId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" },
      "ScopeId": { "$ref": "#/components/schemas/OpaqueId" },
      "WorkspaceId": { "$ref": "#/components/schemas/OpaqueId" },
      "RuntimeId": { "$ref": "#/components/schemas/OpaqueId" },
      "HostProfileId": { "$ref": "#/components/schemas/OpaqueId" },
      "Revision": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._~-]{0,127}$" },
      "Generation": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,63}$" },
      "Cursor": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+={0,2}$" },
      "EventId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" },
      "EntityTag": { "type": "string", "minLength": 3, "maxLength": 130, "pattern": "^\"[A-Za-z0-9][A-Za-z0-9:._~-]{0,127}\"$" },
      "Timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
      "DisplayName": { "type": "string", "minLength": 1, "maxLength": 128 },
      "BoundedCode": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" },
      "BoundedMessage": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "HttpsUrl": { "type": "string", "format": "uri", "minLength": 12, "maxLength": 2048, "pattern": "^https://[^/@\\s?#]+/v1$" },
      "WssUrl": { "type": "string", "format": "uri", "minLength": 12, "maxLength": 2048, "pattern": "^wss://[^/@\\s?#]+/v1/ws$" },
      "CmuxWssUrl": { "type": "string", "format": "uri", "minLength": 13, "maxLength": 2048, "pattern": "^wss://[^/@\\s?#]+/v1/cmux/[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" },
      "WssUrlTemplate": { "type": "string", "minLength": 25, "maxLength": 2048, "pattern": "^wss://[^/@\\s?#]+/v1/cmux/\\{runtimeId\\}$" },
      "PublicHost": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$" },
      "SshUser": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "DesiredState": { "type": "string", "maxLength": 8, "enum": ["Running", "Sleeping", "Stopped"] },
      "Phase": { "type": "string", "enum": ["Pending", "Provisioning", "Starting", "Ready", "Sleeping", "Stopped", "Deleting", "Unavailable", "Degraded", "Failed"] },
      "ConditionStatus": { "type": "string", "enum": ["True", "False", "Unknown"] },
      "Condition": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type", "status", "reason", "lastTransitionTime"],
        "properties": {
          "type": { "$ref": "#/components/schemas/BoundedCode" },
          "status": { "$ref": "#/components/schemas/ConditionStatus" },
          "reason": { "$ref": "#/components/schemas/BoundedCode" },
          "message": { "$ref": "#/components/schemas/BoundedMessage" },
          "lastTransitionTime": { "$ref": "#/components/schemas/Timestamp" }
        }
      },
      "ProtocolDiscovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["machineProvider", "cmux", "application"],
        "properties": {
          "machineProvider": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "const": "machine-provider-v1" } },
          "cmux": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "integer", "const": 10 } },
          "application": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "const": "omp-app/1" } }
        }
      },
      "SshEndpoint": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "port"],
        "properties": {
          "host": { "$ref": "#/components/schemas/PublicHost" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      },
      "Discovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "apiVersion", "restBaseUrl", "protocols"],
