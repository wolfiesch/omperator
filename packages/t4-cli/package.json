{
  "name": "@t4-code/t4-cli",
  "version": "0.2.1",
  "private": true,
  "description": "t4 — terminal UI for T4 Code hosts (cmux-grade TUI over omp-app/1)",
  "bin": {
    "t4": "./dist/t4"
  },
  "scripts": {
    "build": "bun build --compile src/main.ts --outfile dist/t4",
    "check": "tsgo -p tsconfig.json --noEmit",
    "dev": "bun run src/main.ts",
    "test": "bun test test",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@t4-code/protocol": "workspace:*",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "@types/ws": "8.5.13"
  }
}
